<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- La fotocamera serve allo scanner dei sigilli. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      NIENTE android.permission.INTERNET, di proposito.
      La regola 2 del progetto ("niente rete a runtime") qui la fa rispettare il sistema
      operativo: l'app non puo' aprire una connessione nemmeno volendo. Le pagine arrivano
      da WebViewAssetLoader, che le prende dagli assets senza passare dalla rete.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Tema">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
